/* Lang2Sim OpenCode-Style Textual Theme */

Screen {
    background: #0c0c0c;
    color: #e0e0e0;
}

/* Landing Screen */
#landing-container {
    align: center middle;
    width: 100%;
    height: 100%;
}

#landing-inner {
    width: 78;
    height: auto;
    align: center middle;
}

#landing-logo {
    text-align: center;
    margin-bottom: 2;
}

#landing-card {
    width: 74;
    height: auto;
    max-height: 5;
    background: #161616;
    border-left: thick #00d2ff;
    padding: 0 1;
    margin-bottom: 1;
}

Input {
    background: transparent;
    border: none !important;
    height: 1;
    padding: 0;
    margin: 0;
    color: #ffffff;
}

Input:focus {
    border: none !important;
    background: transparent;
}

#badge-row {
    height: 1;
    margin-top: 1;
    color: #747d8c;
}

#landing-shortcuts {
    text-align: center;
    color: #57606f;
    margin-top: 1;
}

#landing-tip {
    text-align: center;
    color: #747d8c;
    margin-top: 1;
}

/* Workspace Screen (80/20 Split) */
#workspace-header {
    dock: top;
    height: 1;
    background: #0a0a0a;
    color: #747d8c;
    padding: 0 1;
    border-bottom: solid #1e272e;
}

#workspace-body {
    width: 100%;
    height: 1fr;
}

#left-pane {
    width: 80%;
    height: 100%;
    background: #0c0c0c;
}

#right-sidebar {
    width: 20%;
    height: 100%;
    background: #0e0e0e;
    border-left: solid #1e272e;
    padding: 1;
}

/* Chat Log & Message Area */
#chat-scroll {
    height: 1fr;
    padding: 1 2;
}

.user-prompt-card {
    background: #141414;
    border-left: thick #00d2ff;
    padding: 0 1;
    margin-bottom: 1;
    color: #ffffff;
}

/* Collapsible Thought Box */
.thought-box {
    margin-bottom: 1;
    padding: 0 1;
}

.thought-header {
    color: #f39c12;
    text-style: bold;
}

.thought-header:hover {
    color: #ffa502;
}

.thought-content {
    background: #121212;
    color: #a4b0be;
    border-left: solid #f39c12;
    padding: 1;
    margin-top: 1;
}

/* Action Status Pills */
.action-pill {
    background: #161616;
    border: solid #222222;
    padding: 0 1;
    margin-bottom: 1;
    color: #ced6e0;
    height: auto;
}

/* Sticky Bottom Input Card */
#sticky-input-card {
    dock: bottom;
    height: auto;
    max-height: 5;
    background: #161616;
    border-left: thick #00d2ff;
    padding: 0 1;
    margin: 1 2;
}

/* Right Sidebar Sections */
.sidebar-section-title {
    color: #f1f2f6;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.sidebar-metric {
    color: #a4b0be;
    margin-left: 1;
}

/* Footer Bar */
#workspace-footer {
    dock: bottom;
    height: 1;
    background: #0a0a0a;
    color: #57606f;
    padding: 0 2;
    border-top: solid #1e272e;
}
