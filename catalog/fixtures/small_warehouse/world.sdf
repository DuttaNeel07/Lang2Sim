<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="small_warehouse">
    <!-- Gazebo Harmonic System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <!-- Physics Parameters -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene & Atmospheric Lighting -->
    <scene>
      <ambient>1.0 1.0 1.0 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>10.0</speed>
        </clouds>
      </sky>
    </scene>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane with Calibrated Surface Friction -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>24.0 20.0</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>24.0 20.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Boundary Walls -->

    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>6.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Procedural Static & Dynamic Obstacles -->
    <model name="rack_1">
      <static>true</static>
      <pose>-2.5 2.5 1.0 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.6 1.0</ambient>
            <diffuse>0.2 0.3 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rack_2">
      <static>true</static>
      <pose>2.5 2.5 1.0 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.6 1.0</ambient>
            <diffuse>0.2 0.3 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rack_3">
      <static>true</static>
      <pose>-2.5 -0.5 1.0 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.6 1.0</ambient>
            <diffuse>0.2 0.3 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rack_4">
      <static>true</static>
      <pose>2.5 -0.5 1.0 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 0.8 2.0</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.6 1.0</ambient>
            <diffuse>0.2 0.3 0.6 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>4.5 -3.5 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.3 1.0</ambient>
            <diffuse>0.7 0.5 0.3 1.0</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>