<?xml version="1.0" ?>
{% if target == "ignition" or target == "fortress" %}
<sdf version="1.8">
  <world name="{{ world_name }}">
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
{% else %}
<sdf version="1.9">
  <world name="{{ world_name }}">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
{% endif %}

    <!-- Physics Parameters -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Scene & Atmospheric Lighting -->
    <scene>
      <ambient>{{ ambient_light }} {{ ambient_light }} {{ ambient_light }} 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
      {% if sky.sky_enabled %}
      <sky>
        <clouds>
          <speed>{{ sky.clouds_speed }}</speed>
        </clouds>
      </sky>
      {% endif %}
    </scene>

    <!-- User Viewport Orbit Camera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>{{ -room.x * 0.4 }} {{ -room.y * 0.4 }} {{ room.z or 5.0 }} 0 0.55 0.785</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>{{ ambient_light }} {{ ambient_light }} {{ ambient_light }} 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane with Calibrated Surface Friction -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ room.x * 2 }} {{ room.y * 2 }}</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>{{ surface_friction }}</mu>
                <mu2>{{ surface_friction }}</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>{{ room.x * 2 }} {{ room.y * 2 }}</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Boundary Walls -->
    {% set half_x = room.x / 2.0 %}
    {% set half_y = room.y / 2.0 %}
    {% set wall_t = 0.2 %}
    {% set wall_h = wall_height %}
    {% set half_h = wall_h / 2.0 %}

    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 {{ half_y }} {{ half_h }} 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>{{ room.x + wall_t }} {{ wall_t }} {{ wall_h }}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>{{ room.x + wall_t }} {{ wall_t }} {{ wall_h }}</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 {{ -half_y }} {{ half_h }} 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>{{ room.x + wall_t }} {{ wall_t }} {{ wall_h }}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>{{ room.x + wall_t }} {{ wall_t }} {{ wall_h }}</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>{{ half_x }} 0 {{ half_h }} 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>{{ wall_t }} {{ room.y + wall_t }} {{ wall_h }}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>{{ wall_t }} {{ room.y + wall_t }} {{ wall_h }}</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>{{ -half_x }} 0 {{ half_h }} 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>{{ wall_t }} {{ room.y + wall_t }} {{ wall_h }}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>{{ wall_t }} {{ room.y + wall_t }} {{ wall_h }}</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Procedural Static & Dynamic Obstacles -->
    {% for obj in objects %}
    {% if "rack" in obj.model_name %}
    <model name="{{ obj.id }}">
      <static>{{ "true" if obj.is_static else "false" }}</static>
      <pose>{{ obj.pose.x }} {{ obj.pose.y }} 0 0 0 {{ obj.pose.yaw }}</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 {{ obj.dimensions.z / 2.0 }} 0 0 0</pose>
          <geometry><box><size>{{ obj.dimensions.x }} {{ obj.dimensions.y }} {{ obj.dimensions.z }}</size></box></geometry>
        </collision>
        <!-- 4 Upright Corner Columns -->
        <visual name="post_fl"><pose>{{ obj.dimensions.x/2.0 - 0.06 }} {{ obj.dimensions.y/2.0 - 0.06 }} {{ obj.dimensions.z/2.0 }} 0 0 0</pose><geometry><box><size>0.12 0.12 {{ obj.dimensions.z }}</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse><ambient>0.1 0.25 0.55 1</ambient></material></visual>
        <visual name="post_fr"><pose>{{ -obj.dimensions.x/2.0 + 0.06 }} {{ obj.dimensions.y/2.0 - 0.06 }} {{ obj.dimensions.z/2.0 }} 0 0 0</pose><geometry><box><size>0.12 0.12 {{ obj.dimensions.z }}</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse><ambient>0.1 0.25 0.55 1</ambient></material></visual>
        <visual name="post_bl"><pose>{{ obj.dimensions.x/2.0 - 0.06 }} {{ -obj.dimensions.y/2.0 + 0.06 }} {{ obj.dimensions.z/2.0 }} 0 0 0</pose><geometry><box><size>0.12 0.12 {{ obj.dimensions.z }}</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse><ambient>0.1 0.25 0.55 1</ambient></material></visual>
        <visual name="post_br"><pose>{{ -obj.dimensions.x/2.0 + 0.06 }} {{ -obj.dimensions.y/2.0 + 0.06 }} {{ obj.dimensions.z/2.0 }} 0 0 0</pose><geometry><box><size>0.12 0.12 {{ obj.dimensions.z }}</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse><ambient>0.1 0.25 0.55 1</ambient></material></visual>
        <!-- 3 Open Industrial Shelves -->
        <visual name="shelf_bottom"><pose>0 0 0.8 0 0 0</pose><geometry><box><size>{{ obj.dimensions.x }} {{ obj.dimensions.y }} 0.08</size></box></geometry><material><diffuse>0.95 0.5 0.05 1</diffuse><ambient>0.8 0.4 0.05 1</ambient></material></visual>
        <visual name="shelf_mid"><pose>0 0 2.0 0 0 0</pose><geometry><box><size>{{ obj.dimensions.x }} {{ obj.dimensions.y }} 0.08</size></box></geometry><material><diffuse>0.95 0.5 0.05 1</diffuse><ambient>0.8 0.4 0.05 1</ambient></material></visual>
        <visual name="shelf_top"><pose>0 0 3.2 0 0 0</pose><geometry><box><size>{{ obj.dimensions.x }} {{ obj.dimensions.y }} 0.08</size></box></geometry><material><diffuse>0.95 0.5 0.05 1</diffuse><ambient>0.8 0.4 0.05 1</ambient></material></visual>
      </link>
    </model>
    {% elif "forklift" in obj.model_name %}
    <model name="{{ obj.id }}">
      <static>{{ "true" if obj.is_static else "false" }}</static>
      <pose>{{ obj.pose.x }} {{ obj.pose.y }} 0 0 0 {{ obj.pose.yaw }}</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 1.05 0 0 0</pose>
          <geometry><box><size>2.4 1.1 2.1</size></box></geometry>
        </collision>
        <visual name="body"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>1.8 1.1 1.1</size></box></geometry><material><diffuse>0.95 0.75 0.05 1</diffuse><ambient>0.85 0.65 0.05 1</ambient></material></visual>
        <visual name="mast"><pose>0.9 0 1.05 0 0 0</pose><geometry><box><size>0.15 0.7 2.1</size></box></geometry><material><diffuse>0.15 0.15 0.15 1</diffuse><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="forks"><pose>1.35 0 0.05 0 0 0</pose><geometry><box><size>0.9 0.65 0.08</size></box></geometry><material><diffuse>0.2 0.2 0.2 1</diffuse><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>
    {% elif "barrel" in obj.model_name %}
    <model name="{{ obj.id }}">
      <static>{{ "true" if obj.is_static else "false" }}</static>
      <pose>{{ obj.pose.x }} {{ obj.pose.y }} 0.5 0 0 {{ obj.pose.yaw }}</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><diffuse>0.15 0.45 0.75 1</diffuse><ambient>0.1 0.3 0.6 1</ambient></material></visual>
      </link>
    </model>
    {% else %}
    <model name="{{ obj.id }}">
      <static>{{ "true" if obj.is_static else "false" }}</static>
      <pose>{{ obj.pose.x }} {{ obj.pose.y }} {{ obj.dimensions.z / 2.0 }} 0 0 {{ obj.pose.yaw }}</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>{{ obj.dimensions.x }} {{ obj.dimensions.y }} {{ obj.dimensions.z }}</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>{{ obj.dimensions.x }} {{ obj.dimensions.y }} {{ obj.dimensions.z }}</size></box></geometry>
          <material>
            {% if "pallet" in obj.model_name %}
            <ambient>0.6 0.45 0.25 1.0</ambient><diffuse>0.65 0.5 0.3 1.0</diffuse>
            {% elif "crate" in obj.model_name or "box" in obj.model_name %}
            <ambient>0.7 0.5 0.3 1.0</ambient><diffuse>0.7 0.5 0.3 1.0</diffuse>
            {% elif "bench" in obj.model_name or "desk" in obj.model_name %}
            <ambient>0.4 0.4 0.4 1.0</ambient><diffuse>0.4 0.4 0.4 1.0</diffuse>
            {% else %}
            <ambient>0.5 0.5 0.5 1.0</ambient><diffuse>0.5 0.5 0.5 1.0</diffuse>
            {% endif %}
          </material>
        </visual>
      </link>
    </model>
    {% endif %}
    {% endfor %}
  </world>
</sdf>
