/* Lang2Sim OpenCode-Style Textual Theme */

Screen {
    background: #0c0c0c;
    color: #e0e0e0;
}

/* Landing Screen */
#landing-container {
    align: center middle;
    width: 100%;
    height: 100%;
}

#landing-inner {
    width: 76;
    height: auto;
    align: center middle;
}

#landing-logo {
    width: 100%;
    height: 4;
    content-align: center middle;
    text-align: center;
    margin-bottom: 2;
}

#landing-card {
    width: 100%;
    height: auto;
    max-height: 5;
    background: #18181b;
    border-left: thick #00d2ff;
    padding: 1 2;
    margin-bottom: 0;
}

Input {
    background: transparent;
    border: none !important;
    height: 1;
    padding: 0;
    margin: 0;
    color: #ffffff;
}

Input:focus {
    border: none !important;
    background: transparent;
}

#badge-row {
    height: 1;
    margin-top: 1;
    color: #747d8c;
}

#shortcuts-container {
    width: 100%;
    align: right middle;
    height: 1;
    margin-top: 1;
}

#landing-shortcuts {
    text-align: right;
    color: #6b7280;
}

#landing-tip {
    text-align: center;
    color: #747d8c;
    margin-top: 2;
}

/* Workspace Screen (80/20 Split) */
#workspace-header {
    dock: top;
    height: 1;
    background: #0a0a0a;
    color: #747d8c;
    padding: 0 1;
    border-bottom: solid #1e272e;
}

#workspace-body {
    width: 100%;
    height: 1fr;
}

#left-pane {
    width: 80%;
    height: 100%;
    background: #0c0c0c;
}

#right-sidebar {
    width: 20%;
    height: 100%;
    background: #0e0e0e;
    border-left: solid #1e272e;
    padding: 1;
}

/* Chat Log & Message Area */
#chat-scroll {
    height: 1fr;
    padding: 1 2;
}

.user-prompt-card {
    background: #141414;
    border-left: thick #00d2ff;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
    color: #ffffff;
    height: auto;
}

.assistant-response {
    background: transparent;
    padding: 0 1;
    margin-bottom: 1;
    color: #e4e4e7;
    height: auto;
}

.assistant-response MarkdownParagraph {
    margin-bottom: 1;
    color: #d1d5db;
}

.assistant-response MarkdownHeader {
    color: #38bdf8;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.assistant-response MarkdownBullet {
    color: #00d2ff;
}

.assistant-response MarkdownCodeBlock {
    background: #18181b;
    border: solid #27272a;
    padding: 1;
    margin: 1 0;
    color: #6ee7b7;
}

.chat-error-card {
    background: #1c1917;
    border-left: thick #ef4444;
    padding: 1 2;
    margin-bottom: 1;
    color: #fca5a5;
    height: auto;
}

/* Collapsible Thought Box */
.thought-box {
    margin-bottom: 1;
    padding: 0 1;
}

.thought-header {
    color: #f39c12;
    text-style: bold;
}

.thought-header:hover {
    color: #ffa502;
}

.thought-content {
    background: #121212;
    color: #a4b0be;
    border-left: solid #f39c12;
    padding: 1;
    margin-top: 1;
}

/* Action Status Pills */
.action-pill {
    background: #161616;
    border: solid #222222;
    padding: 0 1;
    margin-bottom: 1;
    color: #ced6e0;
    height: auto;
}

/* Stage-wise Plan Card */
PlanCard {
    height: auto !important;
    background: #111114;
    border: solid #27272a;
    border-left: thick #a78bfa;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 1;
}

.plan-header {
    height: 1;
    margin-bottom: 1;
}

.plan-title {
    color: #f1f2f6;
    text-style: bold;
}

.plan-counter {
    text-align: right;
    color: #a78bfa;
}

.plan-step {
    height: auto;
    padding: 0 1;
    margin-bottom: 0;
}

/* Sticky Bottom Input Card */
#sticky-input-card {
    dock: bottom;
    height: auto;
    max-height: 5;
    background: #161616;
    border-left: thick #00d2ff;
    padding: 1 2;
    margin: 1 2;
}

/* Right Sidebar Sections */
.sidebar-section-title {
    color: #f1f2f6;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.sidebar-metric {
    color: #a4b0be;
    margin-left: 1;
}

/* Footer Bar */
#workspace-footer {
    dock: bottom;
    height: 1;
    background: #0a0a0a;
    color: #57606f;
    padding: 0 2;
    border-top: solid #1e272e;
}

#workspace-footer .footer-left {
    width: auto;
}

#workspace-footer .footer-spacer {
    width: 1fr;
}

#workspace-footer .footer-right {
    width: auto;
    text-align: right;
}

/* Command Palette Modal (ctrl+p) */
CommandPaletteModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.70);
}

#command-palette-dialog {
    width: 66;
    height: auto;
    max-height: 24;
    background: #161618;
    border: solid #27272a;
    padding: 1 2;
}

#palette-header {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

#palette-title {
    color: #ffffff;
    text-style: bold;
    width: 1fr;
}

#palette-esc {
    color: #6b7280;
    width: auto;
    text-align: right;
}

#palette-search {
    background: transparent;
    border: none !important;
    height: 1;
    padding: 0;
    margin-bottom: 1;
    color: #ffffff;
}

#palette-search:focus {
    border: none !important;
    background: transparent;
}

#palette-search > .input--cursor {
    background: #fdba74;
    color: #000000;
}

#palette-search > .input--placeholder {
    color: #6b7280;
}

#palette-list {
    height: auto;
    max-height: 18;
    scrollbar-size-vertical: 1;
}

.palette-category {
    color: #a78bfa;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.palette-item {
    height: 1;
    padding: 0 1;
    width: 100%;
}

.palette-item-title {
    color: #e5e7eb;
    width: 1fr;
}

.palette-shortcut {
    color: #6b7280;
    width: auto;
    text-align: right;
}

.palette-item.-selected {
    background: #fdba74;
    color: #000000;
}

.palette-item.-selected .palette-item-title {
    color: #000000;
    text-style: bold;
}

.palette-item.-selected .palette-shortcut {
    color: #1f2937;
    text-style: bold;
}

.palette-empty {
    padding: 1 2;
    color: #6b7280;
}

/* Sessions Modal (ctrl+s) - OpenCode Style */
SessionsModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.70);
}

#sessions-dialog {
    width: 68;
    height: auto;
    max-height: 25;
    background: #161618;
    border: solid #27272a;
    padding: 1 2;
}

#sessions-header {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

#sessions-title {
    color: #ffffff;
    text-style: bold;
    width: auto;
}

#sessions-esc {
    color: #71717a;
    width: auto;
    text-align: right;
}

#sessions-search {
    background: #09090b;
    border: solid #27272a;
    color: #ffffff;
    height: 3;
    margin-bottom: 1;
    padding: 0 1;
}

#sessions-search > .input--cursor {
    background: #fdba74;
    color: #000000;
}

#sessions-search > .input--placeholder {
    color: #6b7280;
}

#sessions-list {
    height: auto;
    max-height: 16;
    scrollbar-size-vertical: 1;
}

.session-group-header {
    color: #a78bfa;
    text-style: bold;
    height: 1;
    margin-top: 1;
}

.session-item {
    height: 1;
    padding: 0 1;
    width: 100%;
}

.session-item-text {
    color: #e5e7eb;
    width: 100%;
}

.session-item.-selected {
    background: #fdba74;
    color: #000000;
}

.session-item.-selected .session-item-text {
    color: #000000;
    text-style: bold;
}

.session-empty {
    padding: 1 2;
    color: #6b7280;
}

#sessions-footer {
    height: 1;
    margin-top: 1;
    border-top: solid #27272a;
    padding-top: 0;
}

#sessions-footer-actions {
    color: #71717a;
    width: 100%;
}

/* Demo command output (lang2sim/cli/demo_commands.py) */
.demo-line {
    padding: 0 1;
    height: auto;
    color: #e4e4e7;
}

.demo-table {
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 1;
    height: auto;
}
